{
  "name": "vale-do-sol",
  "version": "2.0.0",
  "description": "Uma pequena vida no campo: fazenda, vila e novas amizades.",
  "author": "Vale do Sol",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz --publish never",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.0",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "br.valedosol.game",
    "productName": "Vale do Sol",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "Vale-do-Sol-Windows-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "artifactName": "Vale-do-Sol-Linux-${version}.${ext}",
      "icon": "desktop/icon.png"
    }
  }
}
